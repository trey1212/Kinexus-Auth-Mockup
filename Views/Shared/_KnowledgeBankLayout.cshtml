@inject Microsoft.Extensions.Options.IOptions<KinexusMockup.Auth.SsoOptions> SsoOptions
@{
    // PhosphoNET lives in its own app. The link in the navbar jumps over there
    // instead of routing to a local KnowledgebankController action. URL comes
    // from SsoOptions (env-var overridable via Sso__PhosphonetPublicUrl).
    var phosphonetUrl = SsoOptions.Value.PhosphonetBase;

    // When the user is not logged in, every Knowledgebank page renders the
    // welcome partial instead of its own content. Once signed in, the layout
    // falls back to @RenderBody() and the actual page shows.
    var isAuthed = User?.Identity?.IsAuthenticated == true;
    var userName = isAuthed ? User!.Identity!.Name : null;
    var currentPath = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Kinexus</title>
        <script type="importmap"></script>

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/knowledgebase.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/KinexusMockup.styles.css" asp-append-version="true" />
        
        <!-- Overrides default styles to change the body directly -->
        <style>
        html, body.knowledgebank {
            margin: 0;
            padding: 0;
            background-color: #071329 !important;
            color: #ffffff;
            min-height: 100vh; 
        }

        .knowledgebank .container {
            background-color: transparent !important;
        }
    </style>
    </head>
    <body class="knowledgebank">
        <div class="container">
            <header>
                <!-- C# logic to dynamically change banner based on current page -->
                @{
                    var bannerPath = ViewData["Banner"]?.ToString() ?? "/img/default-banner.jpg";
                    var currentPage = ViewContext.RouteData.Values["Action"]?.ToString();

                    var navLinks = new Dictionary<string, (string Controller, string Text)>
                    {
                        { "Signet", ("Knowledgebank", "SigNET") },
                        { "Kinatlas", ("Knowledgebank", "KinAtlas") },
                        { "TranscriptoNet", ("Knowledgebank", "TranscriptoNET") },
                        { "PhosphoNet", ("Knowledgebank", "PhosphoNET") },
                        { "OncoNet", ("Knowledgebank", "OncoNET") },
                        { "KinaseNet", ("Knowledgebank", "KinaseNET") },
                        { "DrugKinet", ("Knowledgebank", "DrugKiNET") },
                        { "DrugProNet", ("Knowledgebank", "DrugProNet") },
                        { "KinetAM", ("Knowledgebank", "KiNET-AM") },
                        { "Kinector", ("Knowledgebank", "KiNECTOR") }
                    };
                }

                <img src="@bannerPath" class="banner" alt="Kinexus Banner" />

                <!-- Dynamically change navigation links based on current page -->
                <nav class="navbar">
                    <ul>
                        @foreach (var link in navLinks)
                        {
                            if (link.Key != currentPage)
                            {
                                <li>
                                    @if (link.Key == "PhosphoNet")
                                    {
                                        @* SSO bridge: when this user has a Kinexus cookie, route through
                                           Phosphonet's /Account/Login so an OIDC challenge fires. Phosphonet
                                           bounces to Kinexus /connect/authorize, which already sees the
                                           cookie and silently issues the auth code — no second login UI.
                                           Unauthed users go direct to /PhosphoNet and see the welcome page. *@
                                        var phosphoHref = isAuthed
                                            ? $"{phosphonetUrl}/Account/Login?returnUrl=%2FPhosphoNet"
                                            : $"{phosphonetUrl}/PhosphoNet";
                                        <a class="nav-link" href="@phosphoHref">@link.Value.Text</a>
                                    }
                                    else
                                    {
                                        <a class="nav-link" asp-controller="@link.Value.Controller" asp-action="@link.Key">
                                            @link.Value.Text
                                        </a>
                                    }
                                </li>
                            }
                        }
                    </ul>
                </nav>

                <div class="sub-navbar">

                    <div class="extra-links">
                        @if (isAuthed)
                        {
                            <span>Signed in as <strong>@userName</strong></span>
                        }
                        @await RenderSectionAsync("ExtraLinks", required: false)
                    </div>

                    <div class="main-links">
                        <a href="#">Home</a>
                        <a asp-controller="Home" asp-action="Index">Kinexus</a>
                        <a href="#">Contact</a>
                        <a href="#">Credits</a>
                        @if (isAuthed)
                        {
                            <a asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@currentPath">Log out</a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@currentPath">Log in</a>
                        }
                    </div>

                </div>
            </header>

            <main role="main">
                @if (isAuthed)
                {
                    @RenderBody()
                }
                else
                {
                    IgnoreBody();
                    @await Html.PartialAsync("_KnowledgebankWelcome")
                }
            </main>
        </div>
    </body>
</html>