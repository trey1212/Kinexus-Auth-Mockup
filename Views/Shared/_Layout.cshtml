<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kinexus Prototype</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="logo">Kinexus</div>
        <nav class="main-nav">
            <a href="/">Home</a>
            <div class="dropdown">
                <a href="#">Services</a>
            </div>
            <a href="#">Products</a>
            <a href="#">Resources</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>
        <button class="search-toggle">Search</button>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <p>&copy; 2026 Kinexus Bioinformatics Corporation — <a href="#">Contact Kinexus</a></p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>