<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kinexus Prototype</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <header class="main-header">
        <div class="logo"><img src="/img/kinexus_logo.png" alt="Kinexus Logo"/></div>
        <nav class="main-nav">
            <a href="/">Home</a>
            <a href="#">Services</a>
            <a href="#">Products</a>
            <a href="#">Resources</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
            <a href="#">Search</a>
        </nav>

        <nav class="auth-nav">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <a class="sign-up" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Logout</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Sign-in</a>
                <a class="sign-up" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Sign-up</a>
            }
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <p>&copy; 2026 Kinexus Bioinformatics Corporation — <a href="#">Contact Kinexus</a></p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>