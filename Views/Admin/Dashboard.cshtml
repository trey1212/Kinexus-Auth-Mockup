@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-dashboard">
    <div class="admin-dashboard__header">
        <div>
            <span class="admin-eyebrow">Admin</span>
            <h1 class="admin-dashboard__title">User Dashboard</h1>
            <p class="admin-dashboard__copy">Manage registered users and prepare newsletter campaigns from one place.</p>
        </div>
    </div>

    <div class="admin-summary">
        <div class="admin-summary__card">
            <span class="admin-summary__label">Total Signed Up</span>
            <strong class="admin-summary__value">@Model.TotalUsers</strong>
            <span class="admin-summary__meta">Showing @Model.VisibleUsers user@(Model.VisibleUsers == 1 ? "" : "s") in the current view.</span>
        </div>
        <div class="admin-summary__actions">
            <button type="button" class="btn admin-secondary-button" data-bs-toggle="modal" data-bs-target="#addUserModal">Add User</button>
            <button type="button" class="btn admin-button" data-bs-toggle="modal" data-bs-target="#sendAllModal">Send Email</button>
        </div>
    </div>

    @if (TempData["AdminMessage"] is string adminMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow"
             role="alert"
             style="position: fixed; top: 1rem; right: 1rem; z-index: 2000; max-width: 420px;">
            <strong>Success:</strong> @adminMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["AdminError"] is string adminError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow"
             role="alert"
             style="position: fixed; top: 1rem; right: 1rem; z-index: 2000; max-width: 420px;">
            <strong>Error:</strong> @adminError
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <form method="get" asp-controller="Admin" asp-action="Dashboard" class="admin-toolbar">
        <div class="admin-toolbar__group">
            <label class="admin-toolbar__label" for="sortFilter">Filter users</label>
            <select id="sortFilter" name="sort" class="form-select admin-select">
                <option value="recent" selected="@(Model.CurrentSort == "recent")">Most recent signups</option>
                <option value="alpha-asc" selected="@(Model.CurrentSort == "alpha-asc")">Alphabetical A-Z</option>
                <option value="alpha-desc" selected="@(Model.CurrentSort == "alpha-desc")">Alphabetical Z-A</option>
                <option value="oldest" selected="@(Model.CurrentSort == "oldest")">Oldest signups</option>
            </select>
        </div>
        <div class="admin-toolbar__group admin-toolbar__group--wide">
            <label class="admin-toolbar__label" for="searchUsers">Search</label>
            <input id="searchUsers" name="search" value="@Model.CurrentSearch" class="form-control admin-input admin-input--compact" type="text" placeholder="Search by name or email" />
        </div>
        <div class="admin-toolbar__actions">
            <button type="submit" class="btn admin-button">Apply</button>
            <a class="btn admin-secondary-button" asp-controller="Admin" asp-action="Dashboard">Clear</a>
        </div>
    </form>

    <div class="admin-table-card">
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Joined</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.JoinedOn.ToString("MMM dd, yyyy")</td>

                            <td>
                                <div class="admin-table__actions">

                                    <button type="button"
                                            class="btn admin-table__button admin-table__button--edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editUserModal-@user.Id">
                                        Update
                                    </button>

                                    <button type="button"
                                            class="btn admin-table__button admin-table__button--reset"
                                            data-bs-toggle="modal"
                                            data-bs-target="#resetPasswordModal-@user.Id">
                                        Reset Password
                                    </button>

                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteUser"
                                          style="display:inline;">

                                        <input type="hidden" name="id" value="@user.Id" />

                                        <button type="submit"
                                                class="btn admin-table__button admin-table__button--delete"
                                                onclick="return confirm('Delete @user.FirstName @user.LastName?');">
                                            Delete
                                        </button>

                                    </form>

                                    <button type="button"
                                            class="btn admin-table__button admin-table__button--email"
                                            data-bs-toggle="modal"
                                            data-bs-target="#emailUserModal-@user.Id">
                                        Send Email
                                    </button>

                                    <button type="button"
                                            class="btn admin-table__button admin-table__button--logout"
                                            data-bs-toggle="modal"
                                            data-bs-target="#endSessionModal-@user.Id">
                                        End Session
                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal fade" id="sendAllModal" tabindex="-1" aria-labelledby="sendAllModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content admin-modal">

            <form asp-controller="Admin" asp-action="SendEmailToAll" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header admin-modal__header">
                    <div>
                        <h2 class="modal-title admin-modal__title" id="sendAllModalLabel">Send Newsletter</h2>
                        <p class="admin-modal__subtitle">
                            Compose a message for all registered users.
                        </p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body admin-modal__body">
                    <div class="alert alert-warning">
                        This will send one email to each registered user with an email address.
                        Current dashboard total: <strong>@Model.TotalUsers user@(Model.TotalUsers == 1 ? "" : "s")</strong>.
                    </div>

                    <div>
                        <label class="form-label admin-modal__label">Subject</label>
                        <input class="form-control admin-input"
                               name="Subject"
                               type="text"
                               placeholder="Monthly Kinexus update"
                               required />
                    </div>

                    <div>
                        <label class="form-label admin-modal__label">Message</label>
                        <textarea class="form-control admin-textarea"
                                  name="Message"
                                  rows="7"
                                  placeholder="Write your newsletter content here..."
                                  required></textarea>
                    </div>
                </div>

                <div class="modal-footer admin-modal__footer">
                    <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn admin-button">
                        Send to All Users
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">

            
            <form method="post" asp-controller="Admin" asp-action="AddUser">

                <div class="modal-header admin-modal__header">
                    <div>
                        <h2 class="modal-title admin-modal__title" id="addUserModalLabel">Create User</h2>
                        <p class="admin-modal__subtitle">Add a new mock user entry to the table design.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body admin-modal__body">

                    <div class="admin-modal__grid">
                        <div>
                            <label class="form-label admin-modal__label">First name</label>
                            <input class="form-control admin-input"
                                   type="text"
                                   name="FirstName"
                                   placeholder="First name" />
                        </div>

                        <div>
                            <label class="form-label admin-modal__label">Last name</label>
                            <input class="form-control admin-input"
                                   type="text"
                                   name="LastName"
                                   placeholder="Last name" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label admin-modal__label">Email</label>
                        <input class="form-control admin-input"
                               type="email"
                               name="Email"
                               placeholder="name@example.com" />
                    </div>

                    <div>
                        <label class="form-label admin-modal__label">Password</label>
                        <input class="form-control admin-input"
                               type="password"
                               name="Password"
                               placeholder="Create a password" />
                    </div>

                </div>

                <div class="modal-footer admin-modal__footer">
                    <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn admin-button">
                        Save User
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@foreach (var user in Model.Users)
{
    <div class="modal fade" id="editUserModal-@user.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">

                <form method="post" asp-controller="Admin" asp-action="UpdateUser">

                    <input type="hidden" name="id" value="@user.Id" />

                    <div class="modal-header admin-modal__header">
                        <div>
                            <h2 class="modal-title admin-modal__title">
                                Update User
                            </h2>
                            <p class="admin-modal__subtitle">
                                Adjust the visible details for @user.FirstName @user.LastName.
                            </p>
                        </div>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body admin-modal__body">

                        <div class="admin-modal__grid">
                            <div>
                                <label class="form-label admin-modal__label">First name</label>
                                <input class="form-control admin-input"
                                       type="text"
                                       name="firstName"
                                       value="@user.FirstName" />
                            </div>

                            <div>
                                <label class="form-label admin-modal__label">Last name</label>
                                <input class="form-control admin-input"
                                       type="text"
                                       name="lastName"
                                       value="@user.LastName" />
                            </div>
                        </div>

                        <div>
                            <label class="form-label admin-modal__label">Email</label>
                            <input class="form-control admin-input"
                                   type="email"
                                   name="email"
                                   value="@user.Email" />
                        </div>

                    </div>

                    <div class="modal-footer admin-modal__footer">

                        <button type="button"
                                class="btn admin-secondary-button"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn admin-button">
                            Update User
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <div class="modal fade" id="resetPasswordModal-@user.Id" tabindex="-1" aria-labelledby="resetPasswordModalLabel-@user.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">

                <div class="modal-header admin-modal__header">
                    <div>
                        <h2 class="modal-title admin-modal__title" id="resetPasswordModalLabel-@user.Id">
                            Reset Password
                        </h2>
                        <p class="admin-modal__subtitle">
                            Set a new password for @user.FirstName @user.LastName.
                        </p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <form method="post" asp-controller="Admin" asp-action="ResetPassword">

                    <div class="modal-body admin-modal__body">

                        <input type="hidden" name="userId" value="@user.Id" />

                        <div>
                            <label class="form-label admin-modal__label">User email</label>
                            <input class="form-control admin-input" type="text" value="@user.Email" disabled />
                        </div>

                        <div>
                            <label class="form-label admin-modal__label">New password</label>
                            <input class="form-control admin-input" type="password" name="newPassword" placeholder="Enter a new password" />
                        </div>

                    </div>

                    <div class="modal-footer admin-modal__footer">
                        <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn admin-button">
                            Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteUserModal-@user.Id" tabindex="-1" aria-labelledby="deleteUserModalLabel-@user.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">
                <div class="modal-header admin-modal__header">
                    <div>
                        <h2 class="modal-title admin-modal__title" id="deleteUserModalLabel-@user.Id">Delete User</h2>
                        <p class="admin-modal__subtitle">Remove @user.FirstName @user.LastName from the mock admin list.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body admin-modal__body">
                    <p class="admin-modal__text">
                        This is a visual confirmation state only. In the final implementation, this action can remove the user record.
                    </p>
                </div>
                <div class="modal-footer admin-modal__footer">
                    <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn admin-danger-button" data-bs-dismiss="modal">Delete User</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="emailUserModal-@user.Id" tabindex="-1" aria-labelledby="emailUserModalLabel-@user.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content admin-modal">
                <div class="modal-header admin-modal__header">
                    <div>
                        <h2 class="modal-title admin-modal__title" id="emailUserModalLabel-@user.Id">Send Email</h2>
                        <p class="admin-modal__subtitle">Prepare a message for @user.Email.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form asp-controller="Admin" asp-action="SendEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body admin-modal__body">
                        <input type="hidden" name="UserId" value="@user.Id" />

                        <div>
                            <label class="form-label admin-modal__label">Recipient</label>
                            <input class="form-control admin-input" name="RecipientEmail" type="email" value="@user.Email" readonly />
                        </div>

                        <div>
                            <label class="form-label admin-modal__label">Subject</label>
                            <input class="form-control admin-input" name="Subject" type="text" placeholder="Enter a subject" required />
                        </div>

                        <div>
                            <label class="form-label admin-modal__label">Message</label>
                            <textarea class="form-control admin-textarea" name="Message" rows="7" placeholder="Write your custom message here..." required></textarea>
                        </div>
                    </div>

                    <div class="modal-footer admin-modal__footer">
                        <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn admin-button">Send Email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="endSessionModal-@user.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">

                <div class="modal-header admin-modal__header">
                    <h2 class="modal-title admin-modal__title">End Session</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body admin-modal__body">
                    <p>This will log out @user.Email from all devices.</p>
                </div>

                <div class="modal-footer admin-modal__footer">
                    <form method="post" asp-controller="Admin" asp-action="EndSession">
                        <input type="hidden" name="userId" value="@user.Id" />

                        <button type="button" class="btn admin-secondary-button" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn admin-danger-button">
                            End Session
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}
