@{
    ViewData["Title"] = "Home Page";
    @model HomeViewModel;
}

<section class="hero">
    @await Component.InvokeAsync("Home")

    <div class="hero-subscribe">
        <h3>Subscribe to our mailing list.</h3>
        <form>
            <input type="email" placeholder="Email" required>
            <input type="text" placeholder="First Name">
            <input type="text" placeholder="Last Name">
            <button type="submit">Submit</button>
        </form>
        <small>*We respect your time and privacy...</small>
    </div>
</section>

<section class="services-grid">
    <div class="card">
        <h2>Stock and Custom Antibodies</h2>
        <p>Choose from our inventory of over 1,600 pan- and phosphosite-specific antibodies...</p>
        <button class="btn-discover">Discover</button>
    </div>
</section>

<section class="knowledgebank">
    <h2>SigNET KnowledgeBank</h2>
    <p>Kinexus is pleased to develop and maintain these open-access knowledgebases...</p>
    
    
    <div class="database-grid">
        <div class="db-card">
            <h3>PhosphoNET</h3>
            <p>The world's largest repository of information on over 950,000 known and predicted human phosphorylation sites...</p>
            <a href="/PhosphoNET" class="link-discover">Discover</a>
        </div>
    </div>
</section>