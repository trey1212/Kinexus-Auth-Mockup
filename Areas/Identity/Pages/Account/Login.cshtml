@page
@model KinexusMockup.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "/Areas/Identity/Pages/Shared/_AuthLayout.cshtml";
}

<section class="auth-page">
    <div class="auth-card auth-card--login">
        <div class="auth-card__media">
            <img class="auth-card__brand" src="~/img/auth/logo_and_white_kinexus.png" alt="Kinexus" />
        </div>

        <div class="auth-card__panel">
            <div class="auth-panel__inner">
                <h1 class="auth-title">Login</h1>

                <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                    <label asp-for="Input.Email" class="visually-hidden"></label>
                    <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="Email" />
                    <span asp-validation-for="Input.Email" class="auth-field-error"></span>

                    <label asp-for="Input.Password" class="visually-hidden"></label>
                    <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="auth-field-error"></span>

                    <a asp-page="./ForgotPassword" class="auth-subtle-link">Forgot password?</a>

                    <button id="login-submit" type="submit" class="btn auth-submit">Login</button>

                    <p class="auth-switch-copy">
                        Not a member yet?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
